generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  name               String
  passwordHash       String
  role               String
  showGuide          Boolean  @default(true)
  // true tras un restablecimiento del admin: debe crear su propia contraseña antes de usar la app.
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
}

model Group {
  id         Int        @id @default(autoincrement())
  label      String
  area       String
  color      String
  order      Int        @default(0)
  categories Category[]
}

model Category {
  id        Int     @id @default(autoincrement())
  name      String
  unit      String
  schema    Json    @default("[]")
  // true en materiales que se cortan (acrílico, MDF): sus artículos permiten descontar media pieza.
  allowHalf Boolean @default(false)
  groupId   Int
  group     Group   @relation(fields: [groupId], references: [id])
  items     Item[]
}

model Item {
  id              Int        @id @default(autoincrement())
  name            String
  qty             Float // en pasos de 0.5 (medias piezas); entero si la categoría no tiene allowHalf
  reorder         Int
  characteristics Json       @default("{}")
  codigo          String?
  metraje         String?
  proveedor       String?
  descripcion     String?
  caducidad       DateTime?  @db.Date
  zohoTaskId      String?
  zohoRequestedAt DateTime?
  categoryId      Int
  category        Category   @relation(fields: [categoryId], references: [id])
  movements       Movement[]
  createdAt       DateTime   @default(now())
}

model Movement {
  id      Int      @id @default(autoincrement())
  itemId  Int
  item    Item     @relation(fields: [itemId], references: [id])
  tipo    String
  delta   Float
  antes   Float
  despues Float
  usuario String
  fecha   DateTime @default(now())
}
